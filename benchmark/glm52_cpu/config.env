# Defaults for the end-to-end GLM-5.2 CPU benchmark. Override per machine in
# $HOME/.artemis/glm52_cpu.env (same syntax) or in the environment.

# Model and parallelism: one TP rank per sub-NUMA cluster (docs/hardware-platforms/cpu_server.mdx).
SGLANG_E2E_MODEL=zai-org/GLM-5.2-FP8
SGLANG_E2E_TP=6
SGLANG_E2E_PORT=30100
SGLANG_E2E_SERVER_ARGS="--trust-remote-code --disable-overlap-schedule"
# The CPU engine reserves most free memory for the KV cache (--mem-fraction-static 0.9);
# add --max-total-tokens to SGLANG_E2E_SERVER_ARGS to bound it, and start the Artemis runner
# with --ram-limit-mb above weights plus cache or its memory monitor kills the server.
# Seconds to wait for the server to load the weights and warm up.
SGLANG_E2E_LOAD_TIMEOUT=7200
# Pin cores per rank if needed, e.g. "0-39|43-82|86-125|128-167|171-210|214-253" on a 6980P.
# SGLANG_CPU_OMP_THREADS_BIND=

# Correctness gate: 5-shot GSM8K, last-number scoring, greedy. Set the minimum
# from the CUDA run of the same model minus the run-to-run noise (about 3 points at 200 questions).
SGLANG_E2E_GSM8K_N=200
SGLANG_E2E_GSM8K_MIN_ACC=0.85
SGLANG_E2E_GSM8K_PARALLEL=16
SGLANG_E2E_GSM8K_MAX_NEW_TOKENS=512

# Performance: input lengths (tokens), output length, prompts per point and concurrency.
SGLANG_E2E_INPUT_LENS="1024 8192"
SGLANG_E2E_OUTPUT_LEN=1024
SGLANG_E2E_NUM_PROMPTS=4
SGLANG_E2E_CONCURRENCY=4
